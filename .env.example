DISCORD_CLIENT_ID=
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to run /admin commands.
ADMIN_IDS=

# Locale used when no user/guild/bot default is set. Must be a supported locale code (en, ja).
DEFAULT_LOCALE=en

# Where per-user/guild/bot settings are stored as JSON. Defaults to ./data.
DATA_DIR=

# If set, also save a copy of every generated image to this directory.
# Disabled by default.
SAVE_IMAGES_DIR=

# Path to the bot's icon image, synced to the Discord application by
# `pnpm run deploy:images`. Unset by default — no icon is synced.
ICON_PATH=

# Path to the bot's logo image, drawn as the quote watermark in place of
# the bot's tag. Unset by default — the watermark stays the bot's tag.
LOGO_PATH=

# Process name pm2 registers the bot under (see ecosystem.config.cjs).
# Defaults to "openmiq".
PM2_APP_NAME=

# ── Community-page mirror (optional) ───────────────────────────────────────
# When both SUPABASE_URL and SUPABASE_SERVICE_KEY are set, every real quote
# (never a /fakequote) is mirrored to public.community_quotes for
# blog.nextexgirlfriend.com/community, status 'pending'. Unset either one
# and the mirror is silently disabled — the bot works exactly as upstream.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Discord role id that may approve/reject a mirrored quote by reacting on
# the bot's own reply. Required for the approval step to do anything — with
# this unset, quotes still mirror as 'pending' but can never become public.
MOD_ROLE_ID=

# Reaction that approves a pending quote (or re-approves/retracts nothing —
# see rejection below). ❌ always rejects/retracts; this only configures
# the "yes" side. Defaults to ✅.
APPROVAL_EMOJI=
